# Local dev — full stack on one server
ADMIN_PASSWORD=change-me

# Optional: session signing secret (defaults to a dev value when unset)
# JWT_SECRET=

# Static hosts (Cloudflare Pages, Render Static) — optional browser settings, baked in at build time.
# Leave both unset to publish the bundled directory with no API calls.
# VITE_API_URL=https://your-api.example.com
# VITE_ADMIN_URL=https://your-api.example.com/admin
