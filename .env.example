# Local dev — full stack on one server
ADMIN_PASSWORD=change-me

# Neon pooled URL for the running app. Direct URL (no -pooler) for migrations.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# Static site build only — public pages read cards from the admin Web Service.
# VITE_API_URL=https://shop-lake-norman-admin.onrender.com

# Optional: session signing secret (defaults to a dev value when unset)
# JWT_SECRET=

# Render Static Site only — redirect /admin to the Web Service (set at build time)
# VITE_ADMIN_URL=https://shop-lake-norman-admin.onrender.com/admin
